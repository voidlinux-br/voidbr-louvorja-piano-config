#!/usr/bin/env bash
# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=voidbr-louvorja-piano-config
pkgdesc="Skel config for VoidBR with LouvorJa-Piano"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=(voidbr-plasma-config-louvorja-piano)  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=(voidbr-plasma-config-louvorja-piano)  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=(voidbr-plasma-config-louvorja-piano) # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	louvorja-piano
	voidbr-wallpapers
	vlc
	google-chrome
)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	[ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation if present
	[ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

}

pre_install() {
  log "Iniciando instalação"
}

post_install() {
  if [ "${update:-}" = "yes" ]; then
    log "Finalizando upgrade"
  else
    log "Finalizando instalação"
  fi

}

pre_upgrade() {
  log "Iniciando upgrade"
}

post_upgrade() {
  post_install
}
